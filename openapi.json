  "info": {
    "title": "NGX document API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SectionDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionTitle": {
            "type": "string"
          },
          "sectionDescription": {
            "type": "string",
            "default": ""
          },
          "summary": {
            "type": "number"
          },
          "menuSvgPath": {
            "type": "string"
          },
          "headerSvgPath": {
            "type": "string"
          },
          "categoriesLastUpdated": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "sectionTitle",
          "sectionDescription",
          "summary",
          "menuSvgPath",
          "headerSvgPath",
          "categoriesLastUpdated"
        ]
      },
      "WorkshopPageIdentifierDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Workshop entry ID; for PAGE entries this is the document page ID."
          },
          "name": {
            "type": "string",
            "description": "Workshop navigation label."
          },
          "sortId": {
            "type": "number",
            "description": "Position of the entry in the workshop journey"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PAGE"
            ]
          }
        },
        "required": [
          "_id",
          "name",
          "sortId",
          "kind"
        ]
      },
      "AssessmentTestIdentifierDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Workshop entry ID; for PAGE entries this is the document page ID."
          },
          "name": {
            "type": "string",
            "description": "Workshop navigation label."
          },
          "sortId": {
            "type": "number",
            "description": "Position of the entry in the workshop journey"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ASSESSMENT_TEST"
            ]
          },
          "resourceId": {
            "type": "string",
            "description": "Opaque assessment-test ID supplied by the frontend"
          }
        },
        "required": [
          "_id",
          "name",
          "sortId",
          "kind",
          "resourceId"
        ]
      },
      "CodingLabIdentifierDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Workshop entry ID; for PAGE entries this is the document page ID."
          },
          "name": {
            "type": "string",
            "description": "Workshop navigation label."
          },
          "sortId": {
            "type": "number",
            "description": "Position of the entry in the workshop journey"
          },
          "kind": {
            "type": "string",
            "enum": [
              "CODING_LAB"
            ]
          },
          "resourceId": {
            "type": "string",
            "description": "Opaque coding-lab ID supplied by the frontend"
          }
        },
        "required": [
          "_id",
          "name",
          "sortId",
          "kind",
          "resourceId"
        ]
      },
      "SectionsMapDto": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SectionDto"
            }
          }
        },
        "required": [
          "sections"
        ]
      },
      "CreateSectionDto": {
        "type": "object",
        "properties": {
          "sectionTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Display name of the section"
          },
          "sectionDescription": {
            "type": "string",
            "description": "Description of the section; an empty string clears it"
          },
          "menuSvgPath": {
            "type": "string"
          },
          "headerSvgPath": {
            "type": "string"
          }
        },
        "required": [
          "sectionTitle"
        ]
      },
      "UpdateSectionDto": {
        "type": "object",
        "properties": {
          "sectionTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Display name of the section"
          },
          "sectionDescription": {
            "type": "string",
            "description": "Description of the section; an empty string clears it"
          },
          "menuSvgPath": {
            "type": "string"
          },
          "headerSvgPath": {
            "type": "string"
          },
          "summary": {
            "type": "number"
          }
        }
      },
      "DeleteResultDto": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean"
          },
          "deletedCount": {
            "type": "number"
          }
        },
        "required": [
          "acknowledged",
          "deletedCount"
        ]
      },
      "WorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocuments": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/WorkshopPageIdentifierDto"
                },
                {
                  "$ref": "#/components/schemas/AssessmentTestIdentifierDto"
                },
                {
                  "$ref": "#/components/schemas/CodingLabIdentifierDto"
                }
              ],
              "discriminator": {
                "propertyName": "kind",
                "mapping": {
                  "PAGE": "#/components/schemas/WorkshopPageIdentifierDto",
                  "ASSESSMENT_TEST": "#/components/schemas/AssessmentTestIdentifierDto",
                  "CODING_LAB": "#/components/schemas/CodingLabIdentifierDto"
                }
              }
            }
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "workshopDocumentGroupId",
          "sectionId",
          "sortId",
          "name",
          "summary",
          "thumbnail",
          "workshopDocuments",
          "workshopDocumentsLastUpdated"
        ]
      },
      "CreateWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "sectionId",
          "name",
          "summary"
        ]
      },
      "UpdateWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateWorkshopPageDto": {
        "type": "object",
        "properties": {
          "workshopId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "default": "Page"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "pageType": {
            "type": "string",
            "default": "PAGE"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "html": {
            "type": "string",
            "description": "Serialized JSON of the document blocks"
          }
        },
        "required": [
          "workshopId"
        ]
      },
      "AddWorkshopReferenceDto": {
        "type": "object",
        "properties": {
          "workshopId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ASSESSMENT_TEST",
              "CODING_LAB"
            ]
          },
          "resourceId": {
            "type": "string",
            "description": "Opaque resource ID; no remote existence check is performed"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "workshopId",
          "kind",
          "resourceId",
          "name"
        ]
      },
      "DeletePageParamsDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "workshopId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "workshopId",
          "name"
        ]
      },
      "EditPageNameUpdateWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "workshopId": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "name",
          "workshopId"
        ]
      },
      "WorkshopPageDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "workshopGroupId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "default": "Page"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "pageType": {
            "type": "string",
            "default": "PAGE"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "html": {
            "type": "string",
            "description": "Serialized JSON of the document blocks"
