  "info": {
    "title": "NGX document API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SectionDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionTitle": {
            "type": "string"
          },
          "summary": {
            "type": "number"
          },
          "menuSvgPath": {
            "type": "string"
          },
          "headerSvgPath": {
            "type": "string"
          },
          "categoriesLastUpdated": {
            "type": "string"
          }
        },
        "required": [
          "_id",
          "sectionTitle",
          "summary",
          "menuSvgPath",
          "headerSvgPath",
          "categoriesLastUpdated"
        ]
      },
      "SectionsMapDto": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SectionDto"
            }
          }
        },
        "required": [
          "sections"
        ]
      },
      "WorkshopDoc": {
        "type": "object",
        "properties": {}
      },
      "WorkshopDocumentIdentifierDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Object id of the workshop-document."
          },
          "name": {
            "type": "string",
            "description": "Display name of the workshop-document."
          },
          "sortId": {
            "type": "number",
            "description": "Position of the doc item in the section's list"
          }
        },
        "required": [
          "_id",
          "name",
          "sortId"
        ]
      },
      "CreateWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkshopDocumentIdentifierDto"
            }
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "sectionId",
          "name",
          "summary"
        ]
      },
      "UpdateWorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkshopDocumentIdentifierDto"
            }
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeleteResultDto": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean"
          },
          "deletedCount": {
            "type": "number"
          }
        },
        "required": [
          "acknowledged",
          "deletedCount"
        ]
      },
      "WorkshopDocumentDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "workshopGroupId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "default": "Page"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "pageType": {
            "type": "string",
            "default": "PAGE"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "html": {
            "type": "string",
            "description": "Serialized JSON of the document blocks"
          },
          "__v": {
            "type": "number"
          }
        },
        "required": [
          "_id",
          "workshopGroupId",
          "name",
          "sortId",
          "pageType",
          "lastUpdated",
          "html",
          "__v"
        ]
      },
      "PageParamsDto": {
        "type": "object",
        "properties": {
          "page": {
            "$ref": "#/components/schemas/WorkshopDocumentDto"
          },
          "workshopId": {
            "type": "string"
          }
        },
        "required": [
          "page",
          "workshopId"
        ]
      },
      "WorkshopDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "workshopDocumentGroupId": {
            "type": "string"
          },
          "sectionId": {
            "type": "string"
          },
          "sortId": {
            "type": "number",
            "default": 0
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string",
            "default": "https://via.placeholder.com/250/400"
          },
          "workshopDocuments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkshopDocumentIdentifierDto"
            }
          },
          "workshopDocumentsLastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "workshopDocumentGroupId",
          "sectionId",
          "sortId",
          "name",
          "summary",
          "thumbnail",
          "workshopDocuments",
          "workshopDocumentsLastUpdated"
        ]
      }
    }
  }
}